PUBLIC_URL=https://34-100-249-2.sslip.io
POSTGRES_PASSWORD=changeme
JWT_SECRET=your-jwt-signing-secret-min-32-chars
CORS_ORIGINS=https://34-100-249-2.sslip.io

# n8n integration (optional). Alerts show in the app without these.
# Shared secret n8n sends as X-Service-Token to the nightly scan endpoint. Leave empty to disable it.
N8N_SERVICE_TOKEN=
# Webhook URL of the "Alert fan-out" workflow (n8n production URL), e.g. http://n8n:5678/webhook/finmind-alerts
N8N_ALERT_WEBHOOK_URL=
